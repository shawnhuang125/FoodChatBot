# =====================================================================
# 🌐 1. 伺服器與非同步佇列配置 (Server & Queue)
# =====================================================================
API_SERVER_HOST=0.0.0.0
API_SERVER_PORT=5000
MAX_CONCURRENT=2
MAX_QUEUE_SIZE=1
API_TIMEOUT=25.0
HTTPX_MAX_CONNECTIONS=100
HTTPX_MAX_KEEPALIVE=20

# =====================================================================
# 🔗 2. 外部上游 API 串接網址 (External APIs)
# =====================================================================
NEW_SEARCH_API_URL=http://192.168.1.113:5000/search_result
PAGE_SEARCH_API_URL=http://192.168.1.118:5004/place_search/page

# =====================================================================
# 🤖 3. 線上推論模型路徑配置 (Models Configuration)
# =====================================================================
BASE_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct
# ⚠️ 修正重點：將線上讀取目錄與微調輸出目錄全面對齊至最新 v3 版本，防範讀錯版本
MODELS_BASE_DIR=models/qwen2.5-7b/v5
TASK1_ADAPTER_DIR=task1/checkpoint-1000
TASK2_ADAPTER_DIR=task2/final_lora_adapter
TASK3_ADAPTER_DIR=task3/final_lora_adapter

# =====================================================================
# ⚙️ 4. 多任務模型線上推論參數 (Inference Parameters)
# =====================================================================
TASK1_MAX_TOKENS=256
TASK1_REP_PENALTY=1.0

TASK2_MAX_TOKENS=512
TASK2_TEMP=0.7
TASK2_TOP_P=0.9
TASK2_REP_PENALTY=1.1

TASK3_MAX_TOKENS=1024
TASK3_TEMP=0.3
TASK3_TOP_P=0.8
TASK3_REP_PENALTY=1.0

# =====================================================================
# 🧠 5. 對話記憶體與系統日誌 (Memory & Logging)
# =====================================================================
MEMORY_MAX_TURNS=3
LOG_FILE_PATH=app.log
LOG_LEVEL=INFO

# =====================================================================
# 🏋️ 6. 基礎微調全局參數備援 (Fine-tuning Global Defaults)
# =====================================================================
FT_BASE_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct
FT_DATASET_DIR=dataset
FT_MODELS_DIR=models/qwen2.5-7b/v6
FT_MODEL_MAX_LENGTH=2048
FT_TARGET_MODULES=q_proj,k_proj,v_proj,o_proj,gate_proj,up_proj,down_proj
FT_OPTIM=paged_adamw_32bit

# ⚡【矩陣並行優化】：8-bit 鋼鐵對齊 float16 提速方案
# 將 Batch Size 提升到 4，累積步數降到 4，保持總 Effective Batch Size = 16 不變。
# Tensor Core 在 Batch 爲 4 的倍數時利用率最高，能大幅壓低妳那 15 小時的訓練地獄！
FT_BATCH_SIZE=2       
FT_GRAD_ACCUM_STEPS=8
FT_LOGGING_STEPS=10
FT_SAVE_STEPS=200

# =====================================================================
# 🎯 [核心重大重構] 各任務微調超參數精準分流區 (Task-specific overrides)
# =====================================================================

# --- 🧪 TASK 1: 餐廳語意解析器 (Strict JSON Mode) ---
FT_TASK1_DATASET=train_task1_shuffled.json
FT_TASK1_OUTPUT_DIR=task1
FT_TASK1_EPOCHS=4              # 🎯 結構重複性高，2 輪即達黃金收斂點（Step 70 封頂），直接省下 1/3 時間
FT_TASK1_LEARNING_RATE=1e-5    # 🎯 溫和低溫學習，保護底層日常對話神經元不被沖毀
FT_TASK1_LORA_R=32             # 中等穩定通道，完美記憶 Logic Tree 2.0 規格
FT_TASK1_LORA_ALPHA=64
FT_TASK1_LORA_DROPOUT=0.01     # 🎯 低雜訊率，逼模型 100% 鎖死嚴格的 JSON 括號與運算子合法全集
FT_TASK1_SAVE_STEPS=200        # 🎯 每 200 步存一次草稿 (整趟存 2 次)

# --- 🗣️ TASK 2: 多輪補問助理 (Natural Chatting Mode) ---
FT_TASK2_DATASET=train_task2_shuffled.json
FT_TASK2_OUTPUT_DIR=task2
FT_TASK2_EPOCHS=2              # 🎯 降到 2 輪，防止死記特定的對話樣板店名
FT_TASK2_LEARNING_RATE=2e-5    # 🔥【重磅調整】：從 3e-5 降到 2e-5！全面給模型降溫，死守日常招呼防線
FT_TASK2_LORA_R=16             # 🎯 極窄通道：不給模型空間去死記硬背，逼它只能學語氣人設
FT_TASK2_LORA_ALPHA=32
FT_TASK2_LORA_DROPOUT=0.15     # 🔥【資訊熵防禦】：從 0.1 提高到 0.15！強迫模型在大腦裡保留隨機彈性
FT_TASK2_SAVE_STEPS=50         # 🔥【核心修正】：改為 50 步存一次！確保 188 步的訓練中能留下 3 個精華草稿供自動挑選！

# --- 🍳 TASK 3: 美食推坑達人 (Data-Grounded NLG Mode) ---
FT_TASK3_DATASET=train_task3_shuffled.json
FT_TASK3_OUTPUT_DIR=task3
FT_TASK3_EPOCHS=2              # 🎯 降到 2 輪，防止模型對特定餐廳評論碎片產生死記
FT_TASK3_LEARNING_RATE=2e-5    # 🎯 穩定低溫學習
FT_TASK3_LORA_R=16             # 中等通道，平衡數字因果連動與推薦文靈活性
FT_TASK3_LORA_ALPHA=32
FT_TASK3_LORA_DROPOUT=0.1      # 🎯 中高雜訊防禦，確保 total_count 與前端卡片數量的強連動
FT_TASK3_SAVE_STEPS=200        # 🎯 每 200 步存一次草稿 (整趟存 2 次)
FT_TASK3_BATCH_SIZE=1          # 🔥 降到 1（單次只進 1 筆，將顯存底線拉到最低）
FT_TASK3_GRAD_ACCUM_STEPS=16   # 🔥 升到 16（1 * 16 = 16，總 Effective Batch Size 維持不變，效果百分之百對齊！

# =====================================================================
# 🎲 7. 資料集生成種子與測試網頁配置 (Generator & GUI)
# =====================================================================
FT_GENERATOR_OUTPUT_FILE=dataset/auto_dataset.json
FT_SHUFFLE_SEED=42
FT_TEST_SEED=91

GUI_DEFAULT_SID=test_user_001
GUI_DEFAULT_LAT=23.001600
GUI_DEFAULT_LNG=120.252800
GUI_API_SERVER_HOST=0.0.0.0
GUI_API_PORT=5000
GUI_API_TIMEOUT=60.0

# ==============================================================================
# 1. 基礎映像檔：使用 12.4 開發版（這是目前 40 系列顯卡在 Docker 裡最穩定的編譯環境）
#    它內建了 nvcc，能讓 bitsandbytes 順利編譯出 8-bit 加速核心
# ==============================================================================
FROM nvidia/cuda:12.4.1-devel-ubuntu22.04

# 設定環境變數
ENV PYTHONUNBUFFERED=1
ENV FORCE_CUDA=1
ENV DEBIAN_FRONTEND=noninteractive

# 設定工作目錄
WORKDIR /app

# ==============================================================================
# 2. 安裝 Python 3.10 與開發工具 (Ubuntu 22.04 預設即為 3.10)
# ==============================================================================
RUN apt-get update && apt-get install -y \
    python3.10 \
    python3-pip \
    python3.10-dev \
    git \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# 修正 python 與 pip 指令的軟連結，確保呼叫時版本正確
RUN ln -sf /usr/bin/python3.10 /usr/bin/python && \
    ln -sf /usr/bin/pip3 /usr/bin/pip

# ==============================================================================
# 3. 獨立安裝你指定的 PyTorch (CUDA 13.0) 
#    雖然底層映像檔是 12.4，但 PyTorch cu130 會自帶 13.0 執行期庫，與驅動 13.1 完美契合
# ==============================================================================
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir torch torchvision --index-url https://download.pytorch.org/whl/cu130

# ==============================================================================
# 4. 安裝其餘的專案依賴套件
# ==============================================================================
# 先複製 requirements.txt (請確認裡面已經刪除 torch 與 torchvision)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# ==============================================================================
# 5. 複製專案程式碼
# ==============================================================================
# 複製目前所有東西進容器的 /app
COPY . .

# 暴露 FastAPI Port
EXPOSE 5000

# ==============================================================================
# 6. 啟動命令 (配合你的路徑：app/main.py)
# ==============================================================================
CMD ["python", "app/main.py"]